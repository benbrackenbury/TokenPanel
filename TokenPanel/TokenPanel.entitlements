<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is intentionally off so TokenPanel can read ~/.grok/auth.json
	     written by `grok login`. Temporary sandbox exceptions are unreliable with
	     ad-hoc / automatic development signing. -->
	<!-- Sparkle cannot load from an ad-hoc signed host with library validation on. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.devplaceholder.P74EYVEP.TokenPanel</string>
	</array>
</dict>
</plist>
