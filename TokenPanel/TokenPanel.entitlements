<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is intentionally off so TokenPanel can read ~/.grok/auth.json
	     written by `grok login`. Temporary sandbox exceptions are unreliable with
	     ad-hoc / automatic development signing. -->
</dict>
</plist>
